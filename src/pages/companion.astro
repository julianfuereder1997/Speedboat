---
import Layout from '../layouts/Layout.astro';
import TodoNote from '../components/TodoNote.astro';
---

<Layout title="Companion · Speedboat">
  <div class="container-page px-6 py-16">
    <h1 class="text-3xl font-semibold text-ink">Der Companion</h1>
    <p class="mt-4 max-w-2xl text-ink-muted">
      Ihr KI-Gesprächspartner für Förderstrategie: Förder-Roadmap, Kapitel-Briefings, Review von
      Antragsentwürfen.
    </p>
    <div class="mt-8">
      <TodoNote>Companion-Preview und CTA folgen in Block 6.</TodoNote>
    </div>
  </div>
</Layout>
