---
import Layout from '../layouts/Layout.astro';
import TodoNote from '../components/TodoNote.astro';
---

<Layout title="Impressum · Speedboat">
  <div class="container-page px-6 py-16">
    <h1 class="text-3xl font-semibold text-ink">Impressum</h1>
    <div class="mt-8 max-w-2xl">
      <TodoNote>
        Platzhalter — rechtlich verbindliche Angaben (Firmenwortlaut, Firmenbuchnummer, Sitz, UID,
        Aufsichtsbehörde/Kammer) folgen und müssen von der Geschäftsführung freigegeben werden. Kein
        Inhalt wurde erfunden.
      </TodoNote>
    </div>
  </div>
</Layout>
