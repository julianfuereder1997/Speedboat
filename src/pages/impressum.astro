---
import Layout from '../layouts/Layout.astro';
import TodoNote from '../components/TodoNote.astro';
import TodoBadge from '../components/TodoBadge.astro';

// RECHTLICHER HINWEIS: Strukturgerüst nach österreichischem Recht (§ 5 ECG,
// § 14 UGB, ggf. § 25 MedienG). Alle konkreten Angaben sind Platzhalter und
// NICHT rechtsgültig. Vor Live-Schaltung zwingend anwaltlich prüfen lassen.
---

<Layout title="Impressum · Speedboat">
  <div class="container-page px-6 py-16">
    <h1 class="text-3xl font-semibold text-ink">Impressum</h1>

    <div class="mt-6 max-w-2xl">
      <TodoNote>
        Diese Seite ist ein Strukturgerüst und noch nicht rechtsgültig. Alle Angaben sind
        Platzhalter und müssen vor Live-Schaltung anwaltlich geprüft werden.
      </TodoNote>
    </div>

    <div class="mt-10 max-w-2xl space-y-10">
      <section aria-labelledby="impressum-angaben">
        <h2 id="impressum-angaben" class="text-lg font-semibold text-ink">
          Angaben gemäß § 5 ECG, § 14 UGB
        </h2>
        <dl class="mt-4 space-y-3 text-sm">
          <div class="flex flex-wrap items-baseline gap-2">
            <dt class="w-56 shrink-0 font-medium text-ink">Firmenwortlaut</dt>
            <dd><TodoBadge /></dd>
          </div>
          <div class="flex flex-wrap items-baseline gap-2">
            <dt class="w-56 shrink-0 font-medium text-ink">Unternehmensgegenstand</dt>
            <dd><TodoBadge /></dd>
          </div>
          <div class="flex flex-wrap items-baseline gap-2">
            <dt class="w-56 shrink-0 font-medium text-ink">Sitz / Anschrift</dt>
            <dd><TodoBadge /></dd>
          </div>
          <div class="flex flex-wrap items-baseline gap-2">
            <dt class="w-56 shrink-0 font-medium text-ink">Firmenbuchnummer</dt>
            <dd><TodoBadge /></dd>
          </div>
          <div class="flex flex-wrap items-baseline gap-2">
            <dt class="w-56 shrink-0 font-medium text-ink">Firmenbuchgericht</dt>
            <dd><TodoBadge /></dd>
          </div>
          <div class="flex flex-wrap items-baseline gap-2">
            <dt class="w-56 shrink-0 font-medium text-ink">UID-Nummer</dt>
            <dd><TodoBadge /></dd>
          </div>
          <div class="flex flex-wrap items-baseline gap-2">
            <dt class="w-56 shrink-0 font-medium text-ink">Vertretungsberechtigte Personen</dt>
            <dd><TodoBadge /></dd>
          </div>
        </dl>
      </section>

      <section aria-labelledby="impressum-kontakt">
        <h2 id="impressum-kontakt" class="text-lg font-semibold text-ink">Kontakt</h2>
        <dl class="mt-4 space-y-3 text-sm">
          <div class="flex flex-wrap items-baseline gap-2">
            <dt class="w-56 shrink-0 font-medium text-ink">E-Mail</dt>
            <dd><TodoBadge /></dd>
          </div>
          <div class="flex flex-wrap items-baseline gap-2">
            <dt class="w-56 shrink-0 font-medium text-ink">Telefon</dt>
            <dd><TodoBadge /></dd>
          </div>
        </dl>
      </section>

      <section aria-labelledby="impressum-aufsicht">
        <h2 id="impressum-aufsicht" class="text-lg font-semibold text-ink">
          Aufsichtsbehörde, Kammer und anwendbare Rechtsvorschriften
        </h2>
        <dl class="mt-4 space-y-3 text-sm">
          <div class="flex flex-wrap items-baseline gap-2">
            <dt class="w-56 shrink-0 font-medium text-ink">Zuständige Kammer</dt>
            <dd><TodoBadge /></dd>
          </div>
          <div class="flex flex-wrap items-baseline gap-2">
            <dt class="w-56 shrink-0 font-medium text-ink">Anwendbare Rechtsvorschriften</dt>
            <dd><TodoBadge /></dd>
          </div>
        </dl>
      </section>

      <section aria-labelledby="impressum-medien">
        <h2 id="impressum-medien" class="text-lg font-semibold text-ink">
          Offenlegung gemäß § 25 Mediengesetz
        </h2>
        <p class="mt-3 text-sm text-ink-muted">
          Ob und in welchem Umfang für diese Website eine Offenlegungspflicht nach dem Mediengesetz
          besteht, ist rechtlich zu klären.
        </p>
        <div class="mt-3"><TodoBadge>Offenlegung folgt nach rechtlicher Klärung</TodoBadge></div>
      </section>

      <section aria-labelledby="impressum-streit">
        <h2 id="impressum-streit" class="text-lg font-semibold text-ink">Online-Streitbeilegung</h2>
        <p class="mt-3 text-sm text-ink-muted">
          Die Europäische Kommission stellt eine Plattform zur Online-Streitbeilegung (OS) bereit:
          <a
            href="https://ec.europa.eu/consumers/odr"
            target="_blank"
            rel="noopener"
            class="text-accent-700 underline hover:text-accent-800"
          >
            ec.europa.eu/consumers/odr
          </a>
          .
        </p>
      </section>
    </div>
  </div>
</Layout>
