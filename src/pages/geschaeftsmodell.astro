---
import Layout from '../layouts/Layout.astro';
import { geschaeftsmodellBloecke } from '../data/geschaeftsmodell';
---

<Layout title="Geschäftsmodell · Speedboat">
  <div class="bg-navy-950 text-paper">
    <div class="container-page px-6 py-16">
      <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Geschäftsmodell</h1>
      <p class="mt-4 max-w-2xl text-navy-200">
        Geschäftsmodellentwicklung, Finanzplanung, Ausfinanzierung, Skalierungslogik — von der
        Vision zum belastbaren Plan.
      </p>
    </div>
  </div>

  <div class="container-page px-6 py-16">
    <div class="grid gap-8 md:grid-cols-2">
      {
        geschaeftsmodellBloecke.map((block) => (
          <div class="rounded-lg border border-line bg-paper-dim p-8">
            <h2 class="text-xl font-semibold text-ink">{block.title}</h2>
            <p class="mt-3 text-sm text-ink-muted">{block.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</Layout>
