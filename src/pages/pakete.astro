---
import Layout from '../layouts/Layout.astro';
import TodoNote from '../components/TodoNote.astro';
---

<Layout title="Leistungspakete & Preise · Speedboat">
  <div class="container-page px-6 py-16">
    <h1 class="text-3xl font-semibold text-ink">Leistungspakete & Preise</h1>
    <p class="mt-4 max-w-2xl text-ink-muted">
      Drei Pakete — Roadmap, Einreichung, Begleitung — für unterschiedliche Phasen Ihrer
      Förderstrategie.
    </p>
    <div class="mt-8">
      <TodoNote>Pakete-Sektion folgt in Block 5.</TodoNote>
    </div>
  </div>
</Layout>
