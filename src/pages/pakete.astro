---
import Layout from '../layouts/Layout.astro';
import Pakete from '../components/Pakete.astro';
import EinstiegsSelektor from '../components/EinstiegsSelektor.astro';
import CompanionTeaser from '../components/CompanionTeaser.astro';
---

<Layout title="Leistungspakete & Preise · Speedboat">
  <div class="bg-navy-950 text-paper">
    <div class="container-page px-6 py-16">
      <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Leistungspakete & Preise</h1>
      <p class="mt-4 max-w-2xl text-navy-200">
        Drei Pakete — Roadmap, Einreichung, Begleitung — für unterschiedliche Phasen Ihrer
        Förderstrategie.
      </p>
    </div>
  </div>
  <EinstiegsSelektor />
  <CompanionTeaser />
  <Pakete />
</Layout>
