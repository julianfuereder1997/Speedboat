---
import Layout from '../layouts/Layout.astro';
import { technologieBloecke } from '../data/technologie';
---

<Layout title="Technologie · Speedboat">
  <div class="bg-navy-950 text-paper">
    <div class="container-page px-6 py-16">
      <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Technologie</h1>
      <p class="mt-4 max-w-2xl text-navy-200">
        Cloud-Architektur, Cloud-Transformation, Automatisierung, Data Science und Machine Learning,
        Security — technische Machbarkeitsbewertung, Architekturentscheidungen und
        Umsetzungsbegleitung.
      </p>
    </div>
  </div>

  <div class="container-page px-6 py-16">
    <blockquote class="max-w-3xl border-l-4 border-accent-600 pl-6 text-lg text-ink">
      Enterprise-Erfahrung aus der Big-Four-Beratung, eingebracht in Vorhaben jeder Größe.
    </blockquote>

    <div class="mt-12 grid gap-8 md:grid-cols-2">
      {
        technologieBloecke.map((block) => (
          <div class="rounded-lg border border-line bg-paper-dim p-8">
            <h2 class="text-xl font-semibold text-ink">{block.title}</h2>
            <p class="mt-3 text-sm text-ink-muted">{block.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</Layout>
