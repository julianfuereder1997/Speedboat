---
import Layout from '../layouts/Layout.astro';
import TodoNote from '../components/TodoNote.astro';
---

<Layout title="Technologie · Speedboat">
  <div class="bg-navy-950 text-paper">
    <div class="container-page px-6 py-16">
      <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Technologie</h1>
      <p class="mt-4 max-w-2xl text-navy-200">
        Cloud-Architektur, Cloud-Transformation, Automatisierung, Data Science und Machine Learning,
        Security — technische Machbarkeitsbewertung, Architekturentscheidungen und
        Umsetzungsbegleitung.
      </p>
    </div>
  </div>
  <div class="container-page px-6 py-16">
    <TodoNote>Vollständiger Seiteninhalt folgt in Block 6 (Unterseiten je Kernleistung).</TodoNote>
  </div>
</Layout>
