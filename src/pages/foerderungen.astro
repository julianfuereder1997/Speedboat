---
import Layout from '../layouts/Layout.astro';
import TodoNote from '../components/TodoNote.astro';
---

<Layout title="Förderungen & Roadmap · Speedboat">
  <div class="container-page px-6 py-16">
    <h1 class="text-3xl font-semibold text-ink">Förderungen & Roadmap im Detail</h1>
    <p class="mt-4 max-w-2xl text-ink-muted">
      Programme, Zeitachse und Budgetlogik im Detail — abgestimmt auf FFG, aws, Wirtschaftsagentur
      Wien und EU-Programme.
    </p>
    <div class="mt-8">
      <TodoNote>Vollständiger Seiteninhalt folgt in Block 7 (Restliche Seiten).</TodoNote>
    </div>
  </div>
</Layout>
