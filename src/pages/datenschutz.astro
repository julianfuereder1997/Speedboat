---
import Layout from '../layouts/Layout.astro';
import TodoNote from '../components/TodoNote.astro';
---

<Layout title="Datenschutz · Speedboat">
  <div class="container-page px-6 py-16">
    <h1 class="text-3xl font-semibold text-ink">Datenschutz</h1>
    <div class="mt-8 max-w-2xl">
      <TodoNote>
        Platzhalter — die Datenschutzerklärung (Verantwortlicher, verarbeitete Daten,
        Rechtsgrundlagen, eingesetzte Dienste wie z. B. der Companion, Betroffenenrechte) folgt und
        muss juristisch geprüft werden. Kein Inhalt wurde erfunden.
      </TodoNote>
    </div>
  </div>
</Layout>
