---
import Layout from '../layouts/Layout.astro';
import Kernleistungen from '../components/Kernleistungen.astro';
import Verzahnung from '../components/Verzahnung.astro';
import Terminbuchung from '../components/Terminbuchung.astro';
import { siteConfig } from '../config/site';
---

<Layout title={`${siteConfig.name} — Venture Development`}>
  <section class="bg-navy-950 text-paper">
    <div class="container-page px-6 py-20">
      <h1 class="max-w-2xl text-3xl font-semibold tracking-tight sm:text-4xl">
        Förderung, Technologie, Geschäftsmodell — aus einer Hand.
      </h1>
      <p class="mt-4 max-w-lg text-navy-200">
        Speedboat bringt Ihr Vorhaben von der Idee zur Umsetzung, mit einem Team für alle drei
        Kernleistungen.
      </p>
      <a
        href={siteConfig.ctaHref}
        class="mt-8 inline-block rounded-md bg-accent-700 px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-accent-600"
      >
        Termin buchen
      </a>
    </div>
  </section>

  <Kernleistungen />

  <Verzahnung />

  <Terminbuchung />
</Layout>
