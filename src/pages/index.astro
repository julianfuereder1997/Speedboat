---
import Layout from '../layouts/Layout.astro';
import Roadmap from '../components/Roadmap.astro';
import TodoNote from '../components/TodoNote.astro';
import { siteConfig } from '../config/site';
---

<Layout title={`${siteConfig.name} — Förderberatung mit Geschwindigkeit`}>
  <section class="bg-navy-950 text-paper">
    <div class="container-page px-6 py-24">
      <h1 class="max-w-2xl text-4xl font-semibold tracking-tight sm:text-5xl">
        {siteConfig.tagline}
      </h1>
      <p class="mt-6 max-w-xl text-lg text-navy-200">
        {siteConfig.description}
      </p>
      <a
        href={siteConfig.ctaHref}
        class="mt-8 inline-block rounded-md bg-accent-700 px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-accent-600"
      >
        {siteConfig.ctaLabel}
      </a>
    </div>
  </section>

  <Roadmap />

  <div class="container-page px-6 py-16">
    <TodoNote>Pakete-Sektion und Companion-Sektion folgen in den nächsten Blöcken (5–6).</TodoNote>
  </div>
</Layout>
