---
import Layout from '../layouts/Layout.astro';
import LeistungsTabs from '../components/LeistungsTabs.astro';
import EinstiegsSelektor from '../components/EinstiegsSelektor.astro';
import Pakete from '../components/Pakete.astro';
import Companion from '../components/Companion.astro';
import TodoNote from '../components/TodoNote.astro';
import { siteConfig } from '../config/site';
---

<Layout title={`${siteConfig.name} — Venture Development`}>
  <section class="bg-navy-950 text-paper">
    <div class="container-page px-6 py-24">
      <h1 class="max-w-2xl text-4xl font-semibold tracking-tight sm:text-5xl">
        {siteConfig.tagline}
      </h1>
      <p class="mt-6 max-w-xl text-lg text-navy-200">
        {siteConfig.description}
      </p>
      <a
        href={siteConfig.ctaHref}
        class="mt-8 inline-block rounded-md bg-accent-700 px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-accent-600"
      >
        {siteConfig.ctaLabel}
      </a>
    </div>
  </section>

  <LeistungsTabs />

  <EinstiegsSelektor />

  <div class="container-page px-6 py-16">
    <TodoNote>Die Verzahnungs-Sektion folgt in Block 7.</TodoNote>
  </div>

  <Pakete />

  <Companion />
</Layout>
