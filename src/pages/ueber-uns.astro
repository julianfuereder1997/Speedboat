---
import Layout from '../layouts/Layout.astro';
import TodoNote from '../components/TodoNote.astro';
---

<Layout title="Über uns · Speedboat">
  <div class="container-page px-6 py-16">
    <h1 class="text-3xl font-semibold text-ink">Über uns</h1>
    <p class="mt-4 max-w-2xl text-ink-muted">Das Team hinter Speedboat.</p>
    <div class="mt-8">
      <TodoNote>Team-Inhalt folgt in Block 7 (Restliche Seiten).</TodoNote>
    </div>
  </div>
</Layout>
