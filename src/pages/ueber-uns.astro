---
import Layout from '../layouts/Layout.astro';
import TodoNote from '../components/TodoNote.astro';
import TodoBadge from '../components/TodoBadge.astro';
import { team } from '../data/team';
---

<Layout title="Über uns · Speedboat">
  <div class="bg-navy-950 text-paper">
    <div class="container-page px-6 py-16">
      <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Über uns</h1>
      <p class="mt-4 max-w-2xl text-navy-200">Das Team hinter Speedboat.</p>
    </div>
  </div>

  <div class="container-page px-6 py-16">
    <div class="grid gap-8 md:grid-cols-3">
      {
        team.map((member) => (
          <div class="rounded-lg border border-line bg-paper-dim p-8">
            <div
              class="flex size-12 items-center justify-center rounded-full bg-navy-800 text-lg font-semibold text-paper"
              aria-hidden="true"
            >
              {member.name.charAt(0)}
            </div>
            <h2 class="mt-4 text-lg font-semibold text-ink">
              {member.name}
              {member.lastNameTodo && (
                <span class="ml-2 align-middle">
                  <TodoBadge>Nachname TODO</TodoBadge>
                </span>
              )}
            </h2>
            <ul class="mt-3 flex flex-wrap gap-2">
              {member.focus.map((item) => (
                <li class="rounded-full bg-navy-100 px-3 py-1 text-xs font-medium text-navy-800">
                  {item}
                </li>
              ))}
            </ul>
            <p class="mt-4 text-sm text-ink-muted">{member.bio}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-12 max-w-2xl">
      <TodoNote>Fotos, Nachname von Christian und ggf. weitere Team-Angaben folgen.</TodoNote>
    </div>
  </div>
</Layout>
