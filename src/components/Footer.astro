---
import { siteConfig } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-navy-800 bg-navy-950 text-navy-300">
  <div class="container-page px-6 py-12">
    <div class="grid gap-10 md:grid-cols-3">
      <div>
        <p class="text-lg font-semibold text-paper">{siteConfig.name}</p>
        <p class="mt-2 max-w-xs text-sm">
          Venture Development — Förderung, Technologie, Geschäftsmodell.
          {siteConfig.locations.join(' · ')}.
        </p>
      </div>

      <nav aria-label="Footer-Navigation">
        <p class="text-sm font-medium text-paper">Seiten</p>
        <ul class="mt-3 space-y-2 text-sm">
          {
            siteConfig.nav.map((item) => (
              <li>
                <a href={item.href} class="hover:text-accent-400">
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a href={siteConfig.ctaHref} class="hover:text-accent-400"> Kontakt </a>
          </li>
          <li>
            <a href="/ansatz" class="hover:text-accent-400"> Ansatz </a>
          </li>
        </ul>
      </nav>

      <nav aria-label="Rechtliches">
        <p class="text-sm font-medium text-paper">Rechtliches</p>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href="/impressum" class="hover:text-accent-400">Impressum</a></li>
          <li><a href="/datenschutz" class="hover:text-accent-400">Datenschutz</a></li>
        </ul>
      </nav>
    </div>

    <div class="mt-10 border-t border-navy-800 pt-6 text-xs text-navy-400">
      © {year}
      {siteConfig.name}. Alle Rechte vorbehalten.
    </div>
  </div>
</footer>
