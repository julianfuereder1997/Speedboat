---
import { pakete } from '../data/pakete';
---

<section id="pakete" aria-labelledby="pakete-heading" class="bg-mist">
  <div class="container-page px-6 py-24">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold tracking-wide text-accent-700 uppercase">Leistungspakete</p>
      <h2
        id="pakete-heading"
        class="mt-2 text-3xl font-semibold tracking-tight text-ink sm:text-4xl"
      >
        Drei Wege, mit uns zu starten
      </h2>
      <p class="mt-4 text-ink-muted">
        Vom ersten Förder-Check bis zur laufenden Förderbetreuung über mehrere Jahre.
      </p>
    </div>

    <div class="mt-16 grid gap-8 md:grid-cols-3 md:items-start">
      {
        pakete.map((paket) => (
          <div
            id={paket.id}
            class={`relative flex h-full scroll-mt-24 flex-col rounded-lg border p-8 ${
              paket.featured
                ? 'border-2 border-accent-600 bg-navy-950 text-paper shadow-xl md:-mt-4 md:mb-4'
                : 'border-line bg-paper text-ink'
            }`}
          >
            {paket.featured && (
              <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-accent-600 px-3 py-1 text-xs font-semibold tracking-wide text-white uppercase">
                Meistgewählt
              </span>
            )}

            <h3 class={`text-xl font-semibold ${paket.featured ? 'text-paper' : 'text-ink'}`}>
              {paket.name}
            </h3>
            <p class={`mt-3 text-sm ${paket.featured ? 'text-navy-200' : 'text-ink-muted'}`}>
              {paket.description}
            </p>

            <p
              class={`mt-6 text-xs font-medium tracking-wide uppercase ${
                paket.featured ? 'text-navy-300' : 'text-navy-500'
              }`}
            >
              {paket.audience}
            </p>

            <div
              class={`price-reveal mt-8 border-t pt-6 ${paket.featured ? 'border-navy-700' : 'border-line'}`}
              data-price-reveal
            >
              <p class={`text-sm ${paket.featured ? 'text-navy-300' : 'text-ink-muted'}`}>
                {paket.priceHint}
              </p>

              <button
                type="button"
                class={`price-toggle mt-2 inline-flex items-center gap-1 text-sm font-medium ${
                  paket.featured ? 'text-accent-400' : 'text-accent-700'
                } hover:underline`}
                aria-expanded="false"
                aria-controls={`price-${paket.id}`}
                data-price-toggle
              >
                <span data-price-toggle-label>Preis anzeigen</span>
                <svg
                  class="price-toggle-icon size-3.5"
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="m5 7.5 5 5 5-5" />
                </svg>
              </button>

              <div id={`price-${paket.id}`} class="price-panel" data-price-panel>
                <div class="price-panel-inner pt-4">
                  <p class={`text-lg font-semibold ${paket.featured ? 'text-paper' : 'text-ink'}`}>
                    {paket.price.label}
                  </p>
                  <p class={`mt-1 text-sm ${paket.featured ? 'text-navy-300' : 'text-ink-muted'}`}>
                    {paket.price.detail}
                  </p>
                </div>
              </div>
            </div>

            <a
              href="/kontakt"
              class={`mt-8 inline-flex items-center justify-center rounded-md px-5 py-3 text-sm font-medium text-white transition-colors ${
                paket.featured
                  ? 'bg-accent-600 hover:bg-accent-500'
                  : 'bg-accent-700 hover:bg-accent-600'
              }`}
            >
              {paket.ctaLabel}
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .price-reveal.js-enabled .price-panel {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 350ms ease-out,
      opacity 250ms ease-out;
  }
  .price-reveal.js-enabled .price-panel-inner {
    min-height: 0;
    overflow: hidden;
  }
  .price-reveal.js-enabled .price-panel.is-open {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .price-toggle-icon {
    transition: transform 200ms ease-out;
  }
  .price-toggle[aria-expanded='true'] .price-toggle-icon {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .price-reveal.js-enabled .price-panel {
      transition: none;
    }
    .price-toggle-icon {
      transition: none;
    }
  }
</style>

<script>
  const reveals = document.querySelectorAll<HTMLElement>('[data-price-reveal]');

  reveals.forEach((reveal) => {
    reveal.classList.add('js-enabled');

    const toggle = reveal.querySelector<HTMLButtonElement>('[data-price-toggle]');
    const panel = reveal.querySelector<HTMLElement>('[data-price-panel]');
    const label = reveal.querySelector<HTMLElement>('[data-price-toggle-label]');
    if (!toggle || !panel || !label) return;

    toggle.addEventListener('click', () => {
      const isOpen = panel.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(isOpen));
      label.textContent = isOpen ? 'Preis verbergen' : 'Preis anzeigen';
    });
  });
</script>
