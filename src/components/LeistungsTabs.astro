---
import { leistungen } from '../data/leistungen';

const pillarStyles: Record<
  string,
  { activeClass: string; textClass: string; softBgClass: string }
> = {
  foerderung: {
    activeClass: 'border-pillar-foerderung text-pillar-foerderung',
    textClass: 'text-pillar-foerderung',
    softBgClass: 'bg-pillar-foerderung-soft',
  },
  technologie: {
    activeClass: 'border-pillar-technologie text-pillar-technologie',
    textClass: 'text-pillar-technologie',
    softBgClass: 'bg-pillar-technologie-soft',
  },
  geschaeftsmodell: {
    activeClass: 'border-pillar-geschaeft text-pillar-geschaeft',
    textClass: 'text-pillar-geschaeft',
    softBgClass: 'bg-pillar-geschaeft-soft',
  },
};
---

<section id="leistungen" aria-labelledby="leistungen-heading" class="bg-mist">
  <div class="container-page px-6 py-24">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold tracking-wide text-accent-700 uppercase">Leistungen</p>
      <h2
        id="leistungen-heading"
        class="mt-2 text-3xl font-semibold tracking-tight text-ink sm:text-4xl"
      >
        Drei Kernleistungen, ein Vorhaben
      </h2>
      <p class="mt-4 text-ink-muted">
        Förderung, Technologie und Geschäftsmodell sind keine getrennten Produkte — die meisten
        Vorhaben brauchen alle drei.
      </p>
    </div>

    <div class="mt-12" data-leistungs-tabs>
      <div hidden data-tablist-wrapper>
        <div
          role="tablist"
          aria-label="Kernleistungen"
          class="flex flex-wrap gap-2 border-b border-mist-line"
        >
          {
            leistungen.map((l, index) => (
              <button
                type="button"
                role="tab"
                id={`tab-${l.id}`}
                aria-controls={`panel-${l.id}`}
                aria-selected={index === 0 ? 'true' : 'false'}
                tabindex={index === 0 ? 0 : -1}
                data-tab
                data-target={l.id}
                data-active-class={pillarStyles[l.id].activeClass}
                class={`-mb-px border-b-2 border-transparent px-4 py-3 text-sm font-medium text-ink-muted transition-colors hover:text-ink ${index === 0 ? pillarStyles[l.id].activeClass : ''}`}
              >
                {l.name}
              </button>
            ))
          }
        </div>
      </div>

      <div class="mt-8 space-y-16" data-panels>
        {
          leistungen.map((l) => (
            <section
              id={l.id}
              aria-labelledby={`heading-${l.id}`}
              data-panel
              data-panel-id={l.id}
              class="leistung-panel scroll-mt-24"
            >
              <h3 id={`heading-${l.id}`} class="text-2xl font-semibold text-ink">
                {l.name}
              </h3>

              <div class="mt-6 grid gap-8 md:grid-cols-3">
                <div>
                  <p class="text-xs font-semibold tracking-wide text-ink-muted uppercase">
                    Was wir tun
                  </p>
                  <p class="mt-2 text-sm text-ink-muted">{l.wasWirTun}</p>
                </div>
                <div>
                  <p class="text-xs font-semibold tracking-wide text-ink-muted uppercase">
                    Typische Fragestellungen
                  </p>
                  <ul class="mt-2 space-y-1.5 text-sm text-ink-muted">
                    {l.fragestellungen.map((frage) => (
                      <li class="flex gap-2">
                        <span
                          class={`mt-2 size-1 shrink-0 rounded-full ${pillarStyles[l.id].softBgClass}`}
                          aria-hidden="true"
                        />
                        <span>{frage}</span>
                      </li>
                    ))}
                  </ul>
                </div>
                <div>
                  <p class="text-xs font-semibold tracking-wide text-ink-muted uppercase">
                    Typisches Ergebnis
                  </p>
                  <p class="mt-2 text-sm text-ink-muted">{l.ergebnis}</p>
                </div>
              </div>

              <a
                href={l.href}
                class={`mt-6 inline-flex items-center gap-1 text-sm font-medium ${pillarStyles[l.id].textClass} hover:underline`}
              >
                Mehr zu {l.name}
                <svg
                  class="size-3.5"
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 10h12M10 4l6 6-6 6" />
                </svg>
              </a>
            </section>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .leistung-panel.panel-enter {
    opacity: 0;
    transform: translateY(4px);
  }
  .leistung-panel.panel-enter-active {
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 0.25s ease,
      transform 0.25s ease;
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-leistungs-tabs]');

  if (root) {
    const wrapper = root.querySelector<HTMLElement>('[data-tablist-wrapper]');
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-panel]'));
    const validIds = new Set(tabs.map((tab) => tab.dataset.target));
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (wrapper) wrapper.hidden = false;

    function activate(
      id: string | undefined,
      options: { updateHash?: boolean; focus?: boolean } = {},
    ) {
      if (!id || !validIds.has(id)) return false;
      const { updateHash = true, focus = false } = options;

      for (const tab of tabs) {
        const isActive = tab.dataset.target === id;
        tab.setAttribute('aria-selected', String(isActive));
        tab.tabIndex = isActive ? 0 : -1;
        const activeClasses = (tab.dataset.activeClass ?? '').split(' ').filter(Boolean);
        tab.classList.toggle('border-transparent', !isActive);
        activeClasses.forEach((cls) => tab.classList.toggle(cls, isActive));
        if (isActive && focus) tab.focus();
      }

      for (const panel of panels) {
        const isActive = panel.dataset.panelId === id;
        const wasHidden = panel.hidden;
        panel.hidden = !isActive;
        if (isActive && wasHidden && !prefersReducedMotion) {
          panel.classList.add('panel-enter');
          requestAnimationFrame(() => {
            panel.classList.add('panel-enter-active');
          });
          panel.addEventListener(
            'transitionend',
            () => panel.classList.remove('panel-enter', 'panel-enter-active'),
            { once: true },
          );
        }
      }

      if (updateHash && location.hash !== `#${id}`) {
        history.replaceState(null, '', `#${id}`);
      }

      return true;
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => activate(tab.dataset.target));
      tab.addEventListener('keydown', (event) => {
        const currentIndex = tabs.indexOf(tab);
        let nextIndex: number | null = null;
        if (event.key === 'ArrowRight') nextIndex = (currentIndex + 1) % tabs.length;
        if (event.key === 'ArrowLeft') nextIndex = (currentIndex - 1 + tabs.length) % tabs.length;
        if (nextIndex !== null) {
          event.preventDefault();
          activate(tabs[nextIndex].dataset.target, { focus: true });
        }
      });
    });

    const initialId = location.hash.replace('#', '');
    if (!activate(initialId, { updateHash: false })) {
      activate(tabs[0]?.dataset.target, { updateHash: false });
    }

    window.addEventListener('hashchange', () => {
      activate(location.hash.replace('#', ''), { updateHash: false });
    });
  }
</script>
